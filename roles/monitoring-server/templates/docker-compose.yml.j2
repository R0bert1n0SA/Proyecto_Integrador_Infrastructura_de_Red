version: '3.8'

networks:
  monitoreo:
    driver: bridge

volumes:
  prometheus_data:
  grafana_data:

services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: unless-stopped
    volumes:
      - /opt/monitoreo/prometheus.yml:/etc/prometheus/prometheus.yml
      - /opt/monitoreo/alerts.yml:/etc/prometheus/alerts.yml
      - prometheus_data:/prometheus
    ports:
      - "9090:9090"
    networks:
      - monitoreo

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped
    environment:
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
    volumes:
      - grafana_data:/var/lib/grafana
      - /opt/monitoreo/provisioning:/etc/grafana/provisioning
      - /opt/monitoreo/provisioning/dashboards_json:/etc/grafana/provisioning/dashboards_json
    ports:
      - "3000:3000"
    networks:
      - monitoreo
    depends_on:
      - prometheus

  alertmanager:
    image: prom/alertmanager:latest
    container_name: alertmanager
    restart: unless-stopped
    volumes:
      - /opt/monitoreo/alertmanager.yml:/etc/alertmanager/alertmanager.yml
    ports:
      - "9093:9093"
    networks:
      - monitoreo